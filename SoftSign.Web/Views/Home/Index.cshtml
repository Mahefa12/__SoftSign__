@{
    ViewData["Title"] = "Tableau de bord";
}

@if (!User.Identity?.IsAuthenticated == true)
{
    <!-- Landing Page for Unauthenticated Users -->
    <div class="landing-container">
        <div class="landing-hero">
            <div class="landing-logo">
                <div class="landing-logo-icon">
                    <i class="bi bi-file-earmark-check-fill"></i>
                </div>
                <span class="landing-logo-text">SoftSign</span>
            </div>
            <h1 class="landing-title">Signature Numérique<br>Élégante et Moderne</h1>
            <p class="landing-subtitle">La solution d'entreprise moderne pour la signature sécurisée de documents</p>
            
            <div class="landing-actions">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                    <i class="bi bi-person-plus me-2"></i>Commencer
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Connexion
                </a>
            </div>
        </div>

        <div class="landing-features">
            <div class="row">
                <div class="col-md-4">
                    <div class="landing-feature">
                        <div class="landing-feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h3 class="landing-feature-title">Sécurisé et Conforme</h3>
                        <p class="landing-feature-description">Sécurité de niveau bancaire avec pistes d'audit complètes et conformité juridique</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="landing-feature">
                        <div class="landing-feature-icon">
                            <i class="bi bi-lightning-charge"></i>
                        </div>
                        <h3 class="landing-feature-title">Rapide et Efficace</h3>
                        <p class="landing-feature-description">Signez des documents en quelques secondes avec un flux de travail automatisé</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="landing-feature">
                        <div class="landing-feature-icon">
                            <i class="bi bi-cloud"></i>
                        </div>
                        <h3 class="landing-feature-title">Basé sur le Cloud</h3>
                        <p class="landing-feature-description">Accédez de n'importe où, sur n'importe quel appareil. Aucune installation nécessaire</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Dashboard for Authenticated Users -->
    <div class="page-header">
        <h2 class="page-title">
            <i class="bi bi-speedometer2"></i>
            Bienvenue
        </h2>
        <a asp-controller="Document" asp-action="Upload" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Télécharger un document
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card-header">
                    <span class="stat-card-label">Documents créés</span>
                    <div class="stat-card-icon gold">
                        <i class="bi bi-file-earmark-plus"></i>
                    </div>
                </div>
                <div class="stat-card-value">0</div>
                <div class="stat-card-footer">Total des documents</div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card-header">
                    <span class="stat-card-label">En attente</span>
                    <div class="stat-card-icon warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div class="stat-card-value">0</div>
                <div class="stat-card-footer">
                    <a asp-controller="Workflow" asp-action="Index" class="text-gold text-decoration-none">Voir les actions en attente</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card-header">
                    <span class="stat-card-label">Rejetés</span>
                    <div class="stat-card-icon danger">
                        <i class="bi bi-x-circle"></i>
                    </div>
                </div>
                <div class="stat-card-value">0</div>
                <div class="stat-card-footer">Nécessite attention</div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card-header">
                    <span class="stat-card-label">Terminés</span>
                    <div class="stat-card-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <div class="stat-card-value">0</div>
                <div class="stat-card-footer">Total</div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title">
                <i class="bi bi-lightning-charge"></i>
                Actions rapides
            </h5>
        </div>
        <div class="card-body">
            <div class="quick-actions">
                <a asp-controller="Document" asp-action="Upload" class="quick-action">
                    <div class="quick-action-icon">
                        <i class="bi bi-upload"></i>
                    </div>
                    <span class="quick-action-label">Télécharger un document</span>
                </a>
                <a asp-controller="Workflow" asp-action="Index" class="quick-action">
                    <div class="quick-action-icon">
                        <i class="bi bi-check2-square"></i>
                    </div>
                    <span class="quick-action-label">Revoir les documents</span>
                </a>
                <a asp-controller="Document" asp-action="Index" class="quick-action">
                    <div class="quick-action-icon">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                    <span class="quick-action-label">Mes documents</span>
                </a>
                <a asp-controller="Account" asp-action="Profile" class="quick-action">
                    <div class="quick-action-icon">
                        <i class="bi bi-person"></i>
                    </div>
                    <span class="quick-action-label">Mon profil</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Activity & Pending Actions -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="bi bi-clock-history"></i>
                        Activité récente
                    </h5>
                </div>
                <div class="card-body">
                    <div class="activity-feed">
                        <div class="empty-state py-4">
                            <div class="empty-state-icon">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <p class="empty-state-title">Aucune activité récente</p>
                            <p class="empty-state-description">L'activité de vos documents apparaîtra ici</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="bi bi-list-task"></i>
                        Workflows en attente
                    </h5>
                </div>
                <div class="card-body">
                    <div class="empty-state py-4">
                        <div class="empty-state-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <p class="empty-state-title">Tout est à jour !</p>
                        <p class="empty-state-description">Aucun workflow en attente</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
