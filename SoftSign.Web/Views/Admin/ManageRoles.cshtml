@model IEnumerable<SoftSign.Web.Controllers.RoleManagementViewModel>

@{
    ViewData["Title"] = "Gérer les rôles";
}

<div class="page-header">
    <h2 class="page-title">
        <i class="bi bi-shield"></i>
        Gérer les rôles
    </h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: var(--color-success-light); border: 1px solid var(--color-success); color: var(--color-success);">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-0">
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Nom du rôle</th>
                                <th>Description</th>
                                <th>Utilisateurs</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-shield-check text-gold"></i>
                                            <strong>@role.Name</strong>
                                        </div>
                                    </td>
                                    <td>@role.Description</td>
                                    <td>
                                        <span class="badge badge-draft">@role.UserCount</span>
                                    </td>
                                    <td>
                                        <div class="action-buttons justify-content-end">
                                            @if (role.Name != "SuperAdmin")
                                            {
                                                <form asp-action="DeleteRole" method="post" class="d-inline">
                                                    <input type="hidden" name="name" value="@role.Name" />
                                                    <button type="submit" class="action-btn danger" 
                                                            onclick="return confirm('Êtes-vous sûr de vouloir supprimer le rôle @role.Name ?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-plus-circle"></i>
                    Créer un nouveau rôle
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateRole" method="post">
                    <div class="mb-3">
                        <label for="name" class="form-label">Nom du rôle</label>
                        <input type="text" name="name" id="name" class="form-control" placeholder="Entrez le nom du rôle" required />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-2"></i>Créer le rôle
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-info-circle"></i>
                    Informations sur le rôle
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2"><strong>SuperAdmin</strong> - Accès et contrôle complets au système</p>
                <p class="text-muted small mb-2"><strong>Admin</strong> - Accès administratif à toutes les fonctionnalités</p>
                <p class="text-muted small mb-2"><strong>Manager</strong> - Peut gérer les documents et les flux de travail</p>
                <p class="text-muted small mb-0"><strong>Utilisateur</strong> - Accès standard pour télécharger et signer des documents</p>
            </div>
        </div>
    </div>
</div>
