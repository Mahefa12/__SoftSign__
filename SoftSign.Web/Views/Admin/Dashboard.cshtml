@model SoftSign.Web.Controllers.AdminDashboardViewModel
@using SoftSign.Domain.Enums

@{
    ViewData["Title"] = "Administration";
}

<div class="page-header">
    <h2 class="page-title">
        <i class="bi bi-speedometer2"></i>
        Administration
    </h2>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-label">Total des documents</span>
                <div class="stat-card-icon gold">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.TotalDocuments</div>
            <div class="stat-card-footer">Tout le temps</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-label">En attente</span>
                <div class="stat-card-icon warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.PendingDocuments</div>
            <div class="stat-card-footer">En attente de révision</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-label">Terminés</span>
                <div class="stat-card-icon success">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.CompletedDocuments</div>
            <div class="stat-card-footer">Documents signés</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-label">Total des utilisateurs</span>
                <div class="stat-card-icon gold">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.TotalUsers</div>
            <div class="stat-card-footer">Utilisateurs actifs : @Model.ActiveUsers</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Documents -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title">
                    <i class="bi bi-clock-history"></i>
                    Documents récents
                </h5>
                <a asp-controller="Document" asp-action="Index" class="btn btn-sm btn-outline-primary">Voir tout</a>
            </div>
            <div class="card-body p-0">
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Créé par</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.RecentDocuments)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Document" asp-action="Details" asp-route-id="@doc.Id" class="text-decoration-none fw-semibold" style="color: var(--color-text);">
                                            @doc.Title
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge badge-@GetStatusBadgeClass(doc.Status)">@doc.StatusDisplay</span>
                                    </td>
                                    <td>@doc.CreatedByName</td>
                                    <td>@doc.CreatedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                            @if (!Model.RecentDocuments.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4">
                                        <div class="text-muted">Aucun document récent</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-lightning-charge"></i>
                    Actions rapides
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Document" asp-action="Upload" class="btn btn-primary">
                        <i class="bi bi-upload me-2"></i>Télécharger un document
                    </a>
                    <a asp-controller="Admin" asp-action="ManageUsers" class="btn btn-outline">
                        <i class="bi bi-people me-2"></i>Gérer les utilisateurs
                    </a>
                    <a asp-controller="Admin" asp-action="ManageRoles" class="btn btn-outline">
                        <i class="bi bi-shield me-2"></i>Gérer les rôles
                    </a>
                    <a asp-controller="Workflow" asp-action="Index" class="btn btn-outline">
                        <i class="bi bi-list-task me-2"></i>Voir les flux de travail
                    </a>
                    <a asp-controller="AdminWorkflow" asp-action="Create" class="btn btn-gold">
                        <i class="bi bi-plus-circle me-2"></i>Créer un workflow
                    </a>
                    <a asp-controller="AdminWorkflow" asp-action="Index" class="btn btn-outline">
                        <i class="bi bi-diagram-3 me-2"></i>Gérer les workflows
                    </a>
                </div>
            </div>
        </div>

        <!-- System Info -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-info-circle"></i>
                    Informations système
                </h5>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Utilisateurs actifs</span>
                        <span class="info-value">@Model.ActiveUsers</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">En attente de révision</span>
                        <span class="info-value">@Model.PendingDocuments</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Rejetés</span>
                        <span class="info-value">@Model.RejectedDocuments</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Draft => "draft",
            DocumentStatus.Pending => "pending",
            DocumentStatus.InProgress => "in-progress",
            DocumentStatus.Completed => "completed",
            DocumentStatus.Rejected => "rejected",
            DocumentStatus.Expired => "draft",
            _ => "draft"
        };
    }
}
